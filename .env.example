# Database Configuration (for docker-compose, matches default credentials)
DATABASE_URL=postgresql://referat:referat_secure_pass@db:5432/referat
REDIS_URL=redis://redis:6379/0

# Security Configuration
JWT_SECRET=replace_with_a_secure_random_secret_key_for_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Configuration (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/workspace/storage

# S3 Configuration (only used if STORAGE_BACKEND=s3)
# S3_ENDPOINT=https://your-s3-endpoint.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET_NAME=referat-meetings

# AI/ML Configuration
OLLAMA_HOST=http://host.docker.internal:11434
