{
  "name": "Referat Devcontainer",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "forwardPorts": [
    4200,
    8000,
    5432,
    6379
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "github.copilot",
        "saoudrizwan.claude-dev"
      ]
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.gemini,target=/home/vscode/.gemini,type=bind",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind",
    "source=${localEnv:HOME}/.config/gcloud,target=/home/vscode/.config/gcloud,type=bind"
  ],
  "postCreateCommand": "npm install -g @angular/cli && pip install pre-commit pytest pytest-asyncio pytest-cov pytest-mock ruff black mypy",
  "remoteUser": "vscode",
  "remoteEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "npm_config_yes": "true",
    "DEBIAN_FRONTEND": "noninteractive"
  },
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ]
}